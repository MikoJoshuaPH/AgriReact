# Browser requests use the Vite proxy during development.
VITE_API_BASE_URL=/api

# Backend target used by the Vite development proxy.
# Laragon: http://127.0.0.1 + /finalproject/AgriTrace/public
# PHP built-in server: http://127.0.0.1:8080 + (empty path)
AGRITRACE_BACKEND_URL=http://127.0.0.1
AGRITRACE_BACKEND_PATH=/finalproject/AgriTrace/public

# Geoapify key for the map (browser key, safe to expose)
VITE_GEOAPIFY_API_KEY=
